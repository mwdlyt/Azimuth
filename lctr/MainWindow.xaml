<ui:FluentWindow x:Class="Lctr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="lctr"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F17"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="lctr" ShowMaximize="True" ShowMinimize="True"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="lctr" FontSize="48" FontWeight="Bold"
                           Foreground="#2DD4BF" HorizontalAlignment="Center"/>
                <TextBlock Text="A new app. Start building here."
                           Foreground="#5A5A72" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#151521" Padding="12,6">
            <DockPanel>
                <TextBlock Text="Ready" Foreground="#5A5A72" FontSize="11"
                           DockPanel.Dock="Left"/>
                <TextBlock Text="v0.1" Foreground="#5A5A72" FontSize="11"
                           DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
