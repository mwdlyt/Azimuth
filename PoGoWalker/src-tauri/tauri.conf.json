{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoGo Walker",
  "version": "0.1.0",
  "identifier": "com.pogowalker.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "PoGo Walker",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8723 ws://127.0.0.1:8723 https://*; img-src 'self' data: https://*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/pogo-service"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
