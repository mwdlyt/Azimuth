# Copy to .env (kept server-side; never shipped to the front-end bundle).

# Walking-directions provider (OpenRouteService foot-walking). Without a key the
# service falls back to straight-line routes.
ORS_API_KEY=

# Device tunnel RSD endpoint, from `pymobiledevice3 lockdown start-tunnel`.
# Leave blank to auto-fall-back to the mock device (no iPhone required).
POGO_RSD_HOST=
POGO_RSD_PORT=

# Force the mock device even if a tunnel is configured.
POGO_USE_MOCK=false

# Re-push held teleport position every N seconds so iOS 26 doesn't drift back
# to real GPS (0 disables).
POGO_HEARTBEAT_S=45

# Refuse teleports while a cooldown is active (recommended on).
POGO_LOCK_DURING_COOLDOWN=true
